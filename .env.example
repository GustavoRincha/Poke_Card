# ==============================================================================
# PokeCard - Variáveis de Ambiente
# Copie este arquivo para .env e preencha com as suas credenciais.
# ==============================================================================

# Supabase (Configurações do backend / autenticação e sincronização na nuvem)
# Obtenha em: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# Google Gemini Vision (Opcional - Scanner de cartas com IA multimodal)
# Obtenha em: https://aistudio.google.com/app/apikey
# Nota: O usuário também pode configurar sua própria chave diretamente na interface do app.
VITE_GEMINI_API_KEY=
